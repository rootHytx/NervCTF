# NervCTF configuration — copy to .nervctf.yml and fill in your values.
# nervctf searches upward from --challenges-dir to find this file.
# Fields marked [setup] are written automatically by `nervctf setup`.

# ── CTFd/monitor host ──────────────────────────────────────────────────────────
monitor_ip: 1.2.3.4                  # IP of the machine running CTFd + remote-monitor
monitor_port: 33133                  # remote-monitor port (default: 33133)

# ── Authentication ─────────────────────────────────────────────────────────────
monitor_token: <auto-generated>      # [setup] 64-char hex token; written by nervctf setup

# ── Deployment credentials (used by nervctf setup / setup --upgrade) ───────────
monitor_user: root                   # SSH user on the CTFd host (must have sudo)
monitor_ctfd_path: /home/admin/CTFd  # CTFd install path (default: /home/<monitor_user>/CTFd)
ssh_key_path: ~/.ssh/id_rsa          # [setup] SSH private key (passed to ssh/rsync as -i); its .pub is authorised on the remote

# ── Local challenge directory ──────────────────────────────────────────────────
challenges_path: ./challenges        # Path to your top-level challenges directory

# ── Tuning (optional) ──────────────────────────────────────────────────────────
# These are baked into the remote-monitor environment at setup time.
# Changing them here has no effect until you re-run `nervctf setup --upgrade`.
max_concurrent_provisions: 4        # max parallel docker/compose provisions
max_instances_per_team: 3           # max active instances per team (0 = unlimited)

# ── Domain aliases (optional) ──────────────────────────────────────────────────
ctfd_domain: ctfd.example.com        # shown in admin dashboard links (defaults to monitor_ip)

# ── Split-machine mode (optional) ─────────────────────────────────────────────
# Set runner_ip to run challenge containers on a separate node instead of the CTFd host.
# The CLI rsyncs challenge files directly to the runner; the monitor SSHes to it for Docker ops.
runner_ip: 192.168.1.50             # IP of the challenge runner node
runner_user: docker                 # SSH user on the runner (default: docker)
runner_domain: challenges.example.com  # domain shown to players instead of runner_ip

# ── Event settings (optional) ──────────────────────────────────────────────────
# Applied with `nervctf event apply`. Field names are mapped to CTFd `configs`
# keys (`name` -> ctf_name, `description` -> ctf_description, and so on).
# Run `nervctf event --show` to print the mapped keys without applying them.
event:
  name: "ACME CTF 2026"
  description: "Annual capture-the-flag event."
  start: "2026-10-01T09:00:00Z"     # CTFd datetime string
  end: "2026-10-02T09:00:00Z"
  user_mode: teams                  # teams | users
  challenge_visibility: public      # public | private
  registration_visibility: public   # public | private
  score_visibility: public          # public | private | hidden
  account_visibility: public        # public | private
  verify_emails: false

# ── CTFd first-run admin (optional) ────────────────────────────────────────────
# `nervctf setup` prompts for these and stores them here. The plugin creates the
# account only while CTFd has not been set up (`setup` absent or false). Because
# this file then contains the admin password, keep it chmod 600.
admin:
  user: admin
  email: admin@example.com
  password: change-me
